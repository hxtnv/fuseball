# --- URLs ---
# Public URL of this API (used to build OAuth callback URLs)
BACKEND_URL=https://api.fuseball.io
# Public URL of the client/frontend
FRONTEND_URL=https://fuseball.io

# --- Server ---
# Port the app listens on inside the container. Coolify proxies to this.
PORT=8080
# Leave false on Coolify: Traefik terminates TLS and forwards plain HTTP.
# Set true only when the Node process itself must serve HTTPS (reads ./.ssl/*.pem).
ENABLE_SSL=false

# --- Secrets ---
JWT_SECRET=secret
DISCORD_WEBHOOK_URL=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fuseball?schema=public"
SESSION_SECRET=xxxxxx
OAUTH_DISCORD_CLIENT_ID=000000001111111111111111
OAUTH_DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OAUTH_GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxx.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx