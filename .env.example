# =============================================================================
# Fuseball — single root env file. Every app/package reads THIS file in dev.
# Copy to `.env` (already git-ignored) and fill in the blanks.
#
# In production (e.g. Coolify) you don't need this file — set these as the
# service's environment variables and they'll be used automatically. The
# `--env-file=../../.env` in the dev scripts silently no-ops when the file
# is absent, so the same code works in both places.
# =============================================================================

# --- Database (Supabase) ---------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# DATABASE_URL = the pooled "Transaction" string (port 6543, add ?pgbouncer=true).
# DIRECT_URL   = the direct "Session" string (port 5432), used only for migrations.
# Leave DATABASE_URL empty to run the central server on an in-memory store.
DATABASE_URL=""
DIRECT_URL=""

# --- Secrets (change these for production!) --------------------------------
# JWT_SECRET must be identical on the central server (signs) and game server
# (verifies). INTERNAL_SECRET guards the game->central match-report endpoint.
JWT_SECRET="change-me-in-production"
INTERNAL_SECRET="change-me-in-production"

# --- Networking (optional; sane defaults in code) --------------------------
# CLIENT_ORIGIN restricts CORS on the central server (default "*").
# CLIENT_ORIGIN="https://play.fuseball.example"
# GAME_SERVERS is a JSON array of regions for the server picker. Default = local.
# GAME_SERVERS='[{"id":"eu","name":"Europe","region":"fra","wsUrl":"wss://game-eu.example/ws","httpUrl":"https://game-eu.example"}]'
# CENTRAL_URL is how the game server reaches the central server (default http://localhost:3001).
# CENTRAL_URL="https://api.fuseball.example"

# --- Client (Vite) ---------------------------------------------------------
# Only VITE_-prefixed vars are exposed to the browser bundle. Baked in at build.
VITE_API_URL="http://localhost:3001"
