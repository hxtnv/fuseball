// Prisma schema for Fuseball accounts + stats.
// Supabase gives you TWO connection strings:
//   DATABASE_URL -> the pooled connection (port 6543, ?pgbouncer=true) used at runtime
//   DIRECT_URL   -> the direct connection (port 5432) used for migrations
// Put both in packages/db/.env (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  isAnonymous Boolean  @default(true)
  isAdmin     Boolean  @default(false)
  email       String?  @unique
  googleId    String?  @unique
  friendCode  String?  @unique
  balance     Int      @default(0)
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  goals       Int      @default(0)
  badges      Json     @default("[]") // [{ name, description, awardedAt }]
  skin        String? // active emoji slug
  ownedSkins  String[] @default([]) // emoji slugs the player owns
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  weeklyScores WeeklyScore[]

  @@index([wins, goals])
}

// Per-week score for the weekly leaderboard (resets each Monday 00:00 UTC).
model WeeklyScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime // Monday 00:00 UTC of the score's week
  wins      Int      @default(0)
  goals     Int      @default(0)
  games     Int      @default(0)

  @@unique([userId, weekStart])
  @@index([weekStart, wins, goals])
}

// Marks a completed week as "settled" (badges awarded) so it happens once.
model WeeklySettlement {
  weekStart DateTime @id
  settledAt DateTime @default(now())
}

// Hand-authored news/announcements shown on the menu. Insert rows manually
// (Supabase table editor or Prisma Studio). `description` supports Markdown.
model News {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  description String
  image       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// One play session (a WS connection to a game server). Powers playtime, session
// length, and mid-match quit metrics.
model Session {
  id           String   @id @default(cuid())
  userId       String
  region       String?
  durationSec  Int      @default(0)
  quitMidMatch Boolean  @default(false) // disconnected while a match was in progress
  startedAt    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Periodic sample of concurrent online players, for the CCU-over-time chart.
model CcuSample {
  id     String   @id @default(cuid())
  online Int
  at     DateTime @default(now())

  @@index([at])
}
