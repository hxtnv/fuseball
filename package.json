{
  "name": "fuseball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "bun --filter @fuseball/client dev",
    "dev:server": "bun --filter @fuseball/server dev",
    "dev:game": "bun --filter @fuseball/server-game dev",
    "dev:all": "bun --filter '*' dev",
    "build": "bun --filter @fuseball/client build",
    "typecheck": "bun --filter '*' typecheck",
    "db:generate": "bun x prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "bun x prisma db push --schema packages/db/prisma/schema.prisma",
    "db:pull": "bun x prisma db pull --schema packages/db/prisma/schema.prisma",
    "db:migrate": "bun x prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:studio": "bun x prisma studio --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
